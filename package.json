{
  "name": "silent-hill-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "A browser port of the three Silent Hill J2ME games, and the analysis of their builds behind it. AI-assisted with Claude Opus 5.5. Contains no game files.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "play": "node scripts/serve.mjs",
    "find-route": "node --max-old-space-size=7000 scripts/find-route.mjs",
    "walk-route": "node --max-old-space-size=1024 scripts/walk-route.mjs",
    "all": "node scripts/all.mjs",
    "pin": "node scripts/pin-inputs.mjs",
    "verify": "node scripts/verify-inputs.mjs",
    "fetch-archive": "node scripts/fetch-archive.mjs",
    "compare": "node scripts/compare-builds.mjs",
    "analyze": "node scripts/analyze-data.mjs",
    "opcodes": "node scripts/opcode-table.mjs",
    "render": "node scripts/render-rooms.mjs",
    "code-volume": "node scripts/code-volume.mjs",
    "decompile": "node scripts/decompile.mjs",
    "test": "node --test",
    "format": "biome format --write",
    "format:check": "biome format",
    "lint": "biome lint",
    "check": "biome check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5"
  }
}
